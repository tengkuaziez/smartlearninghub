# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Akun Baru / Terpisah)
# Dapatkan dari Dashboard Supabase -> Project Settings -> API
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"

# GOOGLE APPS SCRIPT WEB APP (Google Drive Uploads & Google Spreadsheet Backup)
# Dapatkan dari Deploy -> New Deployment -> Web App di script.google.com
VITE_GAS_API_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

